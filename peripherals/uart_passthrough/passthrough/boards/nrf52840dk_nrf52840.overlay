/ {
	chosen {
		uart,passthrough = &uart1;
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	current-speed = <9600>;
	status = "okay";

	pinctrl-0 = <&uart1_custom>;
	pinctrl-1 = <&uart1_csleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	uart1_custom: uart1_custom {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 26)>;
			bias-pull-up;
		};
		group2 {
			psels = <NRF_PSEL(UART_TX, 0, 27)>;
		};
	};

	uart1_csleep: uart1_csleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 26)>,
				<NRF_PSEL(UART_TX, 0, 27)>;
			low-power-enable;
		};
	};
};
